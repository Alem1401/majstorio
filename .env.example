# Copy this file to .env beside docker-compose.yml before running Compose.
# Replace the two local infrastructure passwords below. This file contains no real secrets.
# Compose loads .env for interpolation and supplies it to the API and Worker.
# A plain dotnet run command does not load .env automatically.

COMPOSE_PROJECT_NAME=majstorio
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:9.0
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:9.0
DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/runtime:9.0
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-GDR1-ubuntu-22.04
RABBITMQ_IMAGE=rabbitmq:4.2.9-management
API_IMAGE=majstorio-api:0.1.0
WORKER_IMAGE=majstorio-worker:0.1.0

HOST_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=5100
API_CONTAINER_PORT=8080
ASPNETCORE_HTTP_PORTS=${API_CONTAINER_PORT}
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=${DOTNET_ENVIRONMENT}
AllowedHosts=*
Logging__LogLevel__Default=Information
API_BASE_URL_DESKTOP=http://localhost:${API_HOST_PORT}
API_BASE_URL_ANDROID=http://10.0.2.2:${API_HOST_PORT}

# SQL Server starts as infrastructure. The 230070 database/schema and seed data
# still need to be created through your EF Core implementation and migrations.
ACCEPT_EULA=Y
MSSQL_PID=Developer
DATABASE_HOST=sqlserver
DATABASE_PORT=1433
DATABASE_NAME=230070
DATABASE_USER=sa
SQLSERVER_HOST_PORT=1433
MSSQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_SQL_PASSWORD_123!
ConnectionStrings__DefaultConnection="Server=${DATABASE_HOST},${DATABASE_PORT};Database=${DATABASE_NAME};User Id=${DATABASE_USER};Password=${MSSQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True"

# Message publisher/consumer code has not been implemented.
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__UserName=majstorio
RabbitMq__Password=REPLACE_WITH_A_STRONG_LOCAL_BROKER_PASSWORD
RabbitMq__VirtualHost=/
RabbitMq__Exchange=majstorio.events
RabbitMq__Queue=majstorio.notifications
RabbitMq__Sender=Majstorio.WebAPI
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Planned authentication settings. Generate a real random key when implementing JWT.
# These values are not used by the scaffold yet.
Jwt__Issuer=Majstorio
Jwt__Audience=Majstorio.Clients
Jwt__Key=
Jwt__ExpiryMinutes=60

# Planned PayPal sandbox settings. Supply your own sandbox app credentials.
# Payment, capture verification, refund and mobile callback handling remain to implement.
PayPal__BaseUrl=https://api-m.sandbox.paypal.com
PayPal__ClientId=
PayPal__ClientSecret=
PayPal__Currency=EUR
PayPal__ReturnUrl=
PayPal__CancelUrl=
